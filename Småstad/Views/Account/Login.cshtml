@model Småstad.Models.POCO.LoginModel
@{
    Layout = "_HeaderLayout";
    ViewBag.Active = "Login";
}
<main>
    <div class="container">
      <section>
        <h2 class="section-title">Välkommen till Småstads kommun</h2>
        <h3>Inloggning för dig som ska lägga in evenemang</h3>

        <div class="flex-container">
          <div class="flex-col-2">
            <form asp-controller="Account" asp-action="Login" method="post">
                        <div asp-validation-summary="All"></div>

                        <p class="form-group">
                            <label asp-for="UserName">Användarnamn: *</label><br>
                            <input asp-for="UserName">
                            <span asp-validation-for="UserName"></span>
                        </p>

                        <p class="form-group">
                            <label asp-for="Password">Lösenord: *</label><br>
                            <input asp-for="Password" type="password">
                            <span asp-validation-for="Password"></span>
                        </p>
                        <input asp-for="ReturnUrl" type="hidden">
              <p class="form-group">
                <input type="submit" class="btn btn-primary" value="Logga in">
              </p>
            </form>
          </div>
          <div class="flex-col-2">
            <p>
              <img src="../Images/pic_1.jpg" height="162" alt="Ett barn blåser på en maskros">
				      <img src="../Images/pic_2.jpg" height="162" 
                      alt="Åkrar utanför Småstad med hus och kyrkan i bakgrunden">
            </p>
            <p>
              <img src="../Images/pic_3.jpg" height="162" alt="Flygbild över Småstads villaområde">
				      <img src="../Images/pic_4.jpg" height="162" 
                      alt="En kvinna vänder ansiktet mot solen och vinden rör om hennes hår">
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
